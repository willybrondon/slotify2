# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Extension must not link receive_sharing_intent (Flutter plugin uses addApplicationDelegate).
  # RSIShareViewController is compiled directly into the Share Extension target instead.
  target 'Share Extension' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
    end
  end

  # Patch StripeCore Result+Extensions.swift for Swift 5.7+ compatibility
  file = 'Pods/StripeCore/StripeCore/StripeCore/Source/Helpers/Result+Extensions.swift'
  if File.exist?(file)
    text = File.read(file)
    text.gsub!(/var isSuccess: Bool \{\n\s*if case \.success = self \{ true \}\n\}/, "var isSuccess: Bool {\n    if case .success = self { return true }\n    return false\n}")
    File.write(file, text)
  end

  # Xcode 16.4 + sign_in_with_apple < 7: ASAuthorizationError.credentialImport / credentialExport
  [
    File.expand_path('.symlinks/plugins/sign_in_with_apple/ios/Classes/SignInWithAppleError.swift', __dir__),
  ].concat(Dir.glob(File.join(Dir.home, '.pub-cache/hosted/pub.dev/sign_in_with_apple-*/ios/Classes/SignInWithAppleError.swift')))
   .uniq.each do |apple_error_file|
    next unless File.exist?(apple_error_file)
    text = File.read(apple_error_file)
    next if text.include?('.credentialImport') || text.include?('@unknown default')

    patched = text.sub(
      /case \.notInteractive:\n(\s+)return ([^\n]+)\n(\s+)\}/m
    ) do
      indent = Regexp.last_match(1)
      return_val = Regexp.last_match(2)
      close_indent = Regexp.last_match(3)
      "case .notInteractive:\n#{indent}return #{return_val}\n#{indent}case .credentialImport:\n#{indent}return #{return_val}\n#{indent}case .credentialExport:\n#{indent}return #{return_val}\n#{indent}@unknown default:\n#{indent}return #{return_val}\n#{close_indent}}"
    end
    if patched != text
      File.write(apple_error_file, patched)
      puts "Patched SignInWithAppleError.swift at #{apple_error_file}"
    end
  end
end
